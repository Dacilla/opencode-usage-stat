{
  "name": "opencode-usage-stat",
  "version": "2.6.4",
  "description": "Opencode V2 plugin: real-time token/cache/performance stats, 19 provider usage integrations, and polished HTML usage dashboards",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.jsx"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "icons",
    "vendor"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:tui && npm run build:gui",
    "build:types": "tsc --emitDeclarationOnly",
    "build:tui": "node build.tui.mjs",
    "build:gui": "node build.gui.mjs",
    "render": "node build.render.mjs && node --conditions=browser dist-render/render.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.gui.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node build.tests.mjs && node --test \"dist-test/*.test.mjs\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode2",
    "token",
    "usage",
    "stats",
    "tokens",
    "analytics",
    "tui",
    "provider-usage"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDwsgood/opencode-usage-stat.git"
  },
  "homepage": "https://github.com/DDwsgood/opencode-usage-stat#readme",
  "bugs": {
    "url": "https://github.com/DDwsgood/opencode-usage-stat/issues"
  },
  "dependencies": {
    "@opentui/core": "^0.8.1",
    "@opentui/solid": "^0.8.1",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@opencode/client": "2.2.5",
    "@opencode/plugin": "2.2.5",
    "@opencode/theme": "2.2.5",
    "@opentui/keymap": "^0.8.1",
    "@types/node": "^26.6.6",
    "babel-preset-solid": "^1.9.16",
    "effect": "4.0.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.0"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
